# /etc/truman/box.env — chmod 600, owned by root.

# Where the site lives.
TRUMAN_SITE=https://truman.justin06lee.dev

# Must equal TRUMAN_BOX_KEY in the site's environment. This one key
# authenticates the agent's polls, the camera's RTSP publish, and the
# recorder's episode filing.
TRUMAN_BOX_KEY=

# Capture. `v4l2-ctl --list-devices` and `arecord -l` name what you have.
# /dev/videoN is handed out in discovery order and can move on a reboot or a
# replug; the /dev/v4l/by-id/... symlink for the same camera never does —
# prefer it if the number has ever wandered on you.
# `auto` hunts for a working mic; a specific one is better pinned by name so
# a silent onboard line-in can't win the race:  plughw:CARD=<name>,DEV=0
TRUMAN_VIDEO_DEVICE=/dev/video0
TRUMAN_AUDIO_DEVICE=auto
TRUMAN_VIDEO_SIZE=1280x720
TRUMAN_VIDEO_FPS=30
TRUMAN_VIDEO_BITRATE=2500k

# Where finished clips land. Caddy serves this directory.
TRUMAN_CLIPS=/var/lib/truman/clips

# Lets truman-ipwatch repoint the A records when the isp moves the public
# ip. A Cloudflare api token scoped to Zone.DNS edit for the domain. Unset,
# ipwatch still repairs mediamtx's ice candidate and tells you which record
# to change by hand.
CLOUDFLARE_API_TOKEN=
# The records ipwatch watches, space-separated.
TRUMAN_DNS_NAMES="truman.justin06lee.dev media.justin06lee.dev"

# Where the daily backup copies them (truman-backup.timer). Anything rsync
# accepts: user@host:/path over ssh, or a mounted disk. Unset means the
# clips exist on this box's disk and nowhere else — the timer will keep
# saying so in the journal until you either set this or decide you're fine.
TRUMAN_BACKUP_DEST=

TRUMAN_POLL_SECONDS=5
