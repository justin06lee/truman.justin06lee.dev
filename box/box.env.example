# /etc/truman/box.env — chmod 600, owned by root.

# Where the site lives.
TRUMAN_SITE=https://truman.justin06lee.dev

# Must equal TRUMAN_BOX_KEY in the site's environment. This one key
# authenticates the agent's polls, the camera's RTSP publish, and the
# recorder's episode filing.
TRUMAN_BOX_KEY=

# Capture. `v4l2-ctl --list-devices` and `arecord -l` name what you have.
# `auto` hunts for a working mic; a specific one is better pinned by name so
# a silent onboard line-in can't win the race:  plughw:CARD=<name>,DEV=0
TRUMAN_VIDEO_DEVICE=/dev/video0
TRUMAN_AUDIO_DEVICE=auto
TRUMAN_VIDEO_SIZE=1280x720
TRUMAN_VIDEO_FPS=30
TRUMAN_VIDEO_BITRATE=2500k

# Where finished clips land. Caddy serves this directory.
TRUMAN_CLIPS=/var/lib/truman/clips

TRUMAN_POLL_SECONDS=5
