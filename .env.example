# The word people watch with. Unset means nobody can get in, including you.
TRUMAN_PASSWORD=

# Your key. Same login form, but unlocks /studio and the on-air switch.
# Keep it different from TRUMAN_PASSWORD.
TRUMAN_OWNER_KEY=

# Shared with the Arch box. Authenticates the capture agent and the RTSP
# publisher — separate from the viewer password so rotating the word people
# watch with never takes the camera offline. (RTSP, never RTMP: RTMP cannot
# carry Opus, and MediaMTX does not transcode.)
TRUMAN_BOX_KEY=

# Signs the short-lived tokens that let a browser read the video. MediaMTX
# verifies them by calling back to /api/media/auth. Unset leaves the video
# path unguarded, so the site refuses to mint tokens at all.
# Generate with: openssl rand -base64 32
TRUMAN_MEDIA_SECRET=

# Where MediaMTX is reachable from a browser. WHEP and the clip files both
# come from here.
NEXT_PUBLIC_MEDIA_URL=https://media.example.dev
NEXT_PUBLIC_MEDIA_PATH=live

# Where the finished clips live on this machine. Only read when the owner
# deletes an episode — the site unlinks the file directly, since it shares
# the box with the recorder. Deployed anywhere else, a delete still removes
# the row (which is what makes the clip unreachable); the file itself then
# needs cleaning up by hand.
TRUMAN_CLIPS=/var/lib/truman/clips

# Turso. Unset locally and the site uses file:.data/truman.db instead, so a
# fresh clone runs with no env at all.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
